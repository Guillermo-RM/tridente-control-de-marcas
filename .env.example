# URL publica de cada entorno. No reutilizar secretos entre entornos.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor. Nunca usar el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
RATE_LIMIT_HASH_SECRET=
QR_SIGNING_SECRET=
CRON_SECRET=

# Solo para ejecutar una vez `npm run provision:master`. Elimina estos valores después.
BOOTSTRAP_ORGANIZATION_NAME=
BOOTSTRAP_ORGANIZATION_SLUG=
BOOTSTRAP_MASTER_NAME=
BOOTSTRAP_MASTER_NICKNAME=
BOOTSTRAP_MASTER_EMAIL=
BOOTSTRAP_MASTER_PASSWORD=
