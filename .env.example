# Variables públicas del navegador: necesarias para conectar con Supabase.
# Dirección del proyecto Supabase.
NEXT_PUBLIC_SUPABASE_URL=
# Clave publicable del proyecto Supabase.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Opcional: dirección pública usada al generar enlaces de puntos QR.
NEXT_PUBLIC_APP_URL=

# Variables privadas del servidor: nunca exponerlas en el navegador.
# Necesaria para operaciones administrativas en Supabase.
SUPABASE_SERVICE_ROLE_KEY=
# Necesaria para proteger los identificadores del límite de intentos.
RATE_LIMIT_HASH_SECRET=
# Necesaria para firmar y validar los códigos QR.
QR_SIGNING_SECRET=
# Necesaria para autorizar la tarea programada de limpieza.
CRON_SECRET=

# Solo para crear inicialmente la organización y su administrador.
# Nombre de la organización inicial.
BOOTSTRAP_ORGANIZATION_NAME=
# Identificador corto de la organización inicial.
BOOTSTRAP_ORGANIZATION_SLUG=
# Nombre del administrador inicial.
BOOTSTRAP_MASTER_NAME=
# Nombre de usuario del administrador inicial.
BOOTSTRAP_MASTER_NICKNAME=
# Correo de la cuenta de autenticación del administrador.
BOOTSTRAP_MASTER_EMAIL=
# Contraseña inicial del administrador.
BOOTSTRAP_MASTER_PASSWORD=

